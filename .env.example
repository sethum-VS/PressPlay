# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ---------------------------------------------------------------------------
# GCP / Gemini — Pattern C (grill-me decision)
# ---------------------------------------------------------------------------
# Local dev: Application Default Credentials (ADC)
#   1. gcloud auth application-default login
#   2. Set GCP_PROJECT_ID (or VERTEX_PROJECT)
#   3. Leave GOOGLE_APPLICATION_CREDENTIALS unset
#
# Docker / GCP VM: service account JSON file
#   1. Place SA key at secrets/gcp-sa.json (gitignored)
#   2. docker-compose mounts it to /secrets/gcp.json
#   3. Set GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json
# ---------------------------------------------------------------------------

GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# VERTEX_PROJECT=          # alias if you prefer legacy names
# VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp.json   # Docker/VM only — do not set for local ADC
# Stub Watcher/Writer only (real yt-dlp + Memvid). Also auto-on when GCP_PROJECT_ID unset.
MOCK_LLM=false

# Processing defaults
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_HOUR=5
QUICK_MINUTES_DEFAULT=10
QUICK_MINUTES_MIN=5
QUICK_MINUTES_MAX=20
FULL_MAX_VIDEO_SECONDS=3600
RESULTS_TTL_HOURS=72

# Optional demo gate (unset = open)
PRESSPLAY_DEMO_SECRET=

# Data paths (relative to project root)
DATA_DIR=data

# Full fast mock: skip yt-dlp/Memvid (UI-only demos). Unset = real ingest unless you set 1.
# Mock LLM without this: real ingest + stub Watcher/Writer + heuristic Graphify (default w/o GCP).
# 1 = force full mock | 0 = never skip ingest (even if GCP unset)
PRESSPLAY_USE_MOCK=
GRAPHIFY_BIN=

# Graphify / Gemini API keys (optional; Vertex SA also works for graphify extract)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
